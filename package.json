{
  "name": "lov2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "docker compose up --build",
    "precheck": "pnpm --filter @lov2/api prisma:generate",
    "check": "pnpm -r --if-present check",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @lov2/web test:e2e",
    "test:e2e:docker": "docker compose --profile test run --rm --build e2e",
    "prebuild": "pnpm --filter @lov2/api prisma:generate",
    "build": "pnpm -r --if-present build",
    "security:audit": "pnpm audit --audit-level moderate"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "fastify": "^5.8.5"
    }
  }
}
