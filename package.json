{
  "name": "lov2",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "scripts": {
    "dev": "docker compose up --build",
    "precheck": "pnpm --filter @lov2/api prisma:generate",
    "check": "pnpm -r --if-present check",
    "lint": "pnpm -r lint",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @lov2/web test:e2e",
    "test:e2e:docker": "docker compose --profile test run --rm --build e2e",
    "prebuild": "pnpm --filter @lov2/api prisma:generate",
    "build": "pnpm -r --if-present build",
    "security:audit": "pnpm audit --audit-level moderate",
    "assets:check": "node scripts/validate-assets.mjs",

    "codex:check": "powershell -ExecutionPolicy Bypass -File scripts/codex-check.ps1 all",
    "codex:check:web": "powershell -ExecutionPolicy Bypass -File scripts/codex-check.ps1 web",
    "codex:check:api": "powershell -ExecutionPolicy Bypass -File scripts/codex-check.ps1 api",
    "codex:check:shared": "powershell -ExecutionPolicy Bypass -File scripts/codex-check.ps1 shared",
    "codex:check:game-data": "powershell -ExecutionPolicy Bypass -File scripts/codex-check.ps1 game-data",
    "codex:check:worker": "powershell -ExecutionPolicy Bypass -File scripts/codex-check.ps1 worker",

    "codex:check:bash": "bash scripts/codex-check.sh all",
    "codex:check:web:bash": "bash scripts/codex-check.sh web",
    "codex:check:api:bash": "bash scripts/codex-check.sh api"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.1",
      "fastify": "^5.8.5",
      "uuid": "^11.1.1"
    }
  }
}
