  "dependencies": {
    "@lov2/art-pipeline": "workspace:*",
    "@lov2/game-data": "workspace:*",
    "@lov2/shared": "workspace:*",
    "@vitejs/plugin-react": "^5.0.4",
    "pixi.js": "^8.18.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  }
}
